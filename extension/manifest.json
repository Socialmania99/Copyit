{
  "manifest_version": 3,
  "name": "Copyit",
  "version": "1.0.0",
  "description": "Copyit — save text, links, code, rich text and images you copy. Search, tag, copy as other formats, and back up locally.",
  "permissions": ["storage", "unlimitedStorage", "contextMenus", "clipboardRead", "clipboardWrite", "downloads"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Copyit",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" }, "description": "Open Copyit" }
  },
  "options_page": "dashboard.html"
}
